// Portfolio dashboard schema.
//
// Design note: Transaction and Contribution are the core ledger —
// Open Positions, Completed Trades, and portfolio totals/percentages
// are all DERIVED from these by replaying transactions in date order
// (see lib/portfolio-engine.ts), never stored, so they can't drift out
// of sync with the ledger.
//
// CashBalance is a deliberate exception to that rule: it's a real
// stored, directly-editable balance, auto-adjusted whenever a
// contribution/outlay, purchase, sale, or exchange happens, but also
// meant to be hand-corrected when it drifts from reality (a bank
// statement doesn't quite match, a fee wasn't logged, etc.) — it is
// NOT recomputed from the ledger on each read the way everything else
// is. CashExchange is a log of currency exchanges only, for the
// Recent Activity feed and an audit trail; the balances themselves
// still live on CashBalance.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Contributor {
  id            Int            @id @default(autoincrement())
  name          String         @unique
  contributions Contribution[]
}

model Contribution {
  id            Int         @id @default(autoincrement())
  contributorId Int
  contributor   Contributor @relation(fields: [contributorId], references: [id])
  // Human label matching the sheet's row labels, e.g. "Initial Investment",
  // "MAR (2025)", "Additional"
  label         String
  // Month the deposit is ATTRIBUTED to (first of that month). This is what the
  // outlay curve and the per-month pivot need, and it is deliberately not the
  // payment date — a month funded two months late still belongs to its own
  // month. See `paidOn` for when the money actually arrived.
  date          DateTime
  // When the money actually ARRIVED, when known. Nullable because it is only
  // known for rows whose payment date was recorded; an unknown date must read
  // as unknown rather than silently counting as on time. Kept separate from
  // `date` so the schedule question ("are we on time?") can be answered
  // without disturbing attribution.
  paidOn        DateTime?
  amount        Float
  createdAt     DateTime    @default(now())

  @@index([contributorId])
  @@index([date])
}

model Transaction {
  id        Int      @id @default(autoincrement())
  date      DateTime
  action    String // "Buy" | "Sell"
  ticker    String
  region    String // "US" | "SG" | "HK"
  qty       Float
  price     Float
  notes     String?
  createdAt DateTime @default(now())

  @@index([ticker, region])
  @@index([date])
}

model CashBalance {
  id        Int      @id @default(autoincrement())
  currency  String   @unique // "SGD" | "USD" | "HKD"
  balance   Float    @default(0)
  updatedAt DateTime @updatedAt
}

// One row per calendar day, written on first page load of that day and
// by the backfill script for days before the app existed. Values are in
// SGD so the series is directly chartable. Like everything else except
// CashBalance, this is DERIVED data — but a snapshot is only written
// once per day (and backfilled from the ledger + historical prices), so
// it captures what the portfolio was worth THAT day, which the live
// ledger can never reconstruct after the fact.
model DailySnapshot {
  id              Int      @id @default(autoincrement())
  date            DateTime @unique // UTC midnight of the calendar day
  holdingsValueSgd Float
  cashValueSgd    Float
  totalValueSgd   Float
  costBasisSgd    Float // total outlay (contributions) recorded as of that date
  createdAt       DateTime @default(now())

  @@index([date])
}

model WatchlistItem {
  id        Int      @id @default(autoincrement())
  ticker    String
  region    String // "US" | "SG" | "HK"
  notes     String?
  createdAt DateTime @default(now())

  @@unique([region, ticker])
}

// Descriptive reference data for a traded instrument — the company/fund
// name, instrument type (equity vs ETF), exchange and trading currency.
//
// This is CACHE, not ledger: it's populated from the same Yahoo chart call
// that already supplies the live price, and it exists so the app never has
// to ask a user to hand-type "VOO - Vanguard S&P 500 ETF" into a note (a
// habit that also produced a "Proctor & Gamble" typo). Nothing here is
// authoritative — if the upstream name is wrong or missing, `nameOverridden`
// lets the owner correct it by hand and the fetch will then leave it alone.
model TickerMeta {
  id             Int       @id @default(autoincrement())
  region         String // "US" | "SG" | "HK"
  ticker         String
  name           String?
  instrumentType String? // "EQUITY" | "ETF" | ...
  exchange       String?
  currency       String?
  // Set when the owner edits `name` by hand. Auto-lookup must never
  // overwrite a name once this is true.
  nameOverridden Boolean   @default(false)
  // Exposure tag: one of the ten tags in lib/sectors.ts ("Financials",
  // "US Tech", "Precious Metals", ...). No free data source classifies
  // these instruments, so a NEW instrument gets a first draft from
  // suggestSector() and the owner edits it; deliberately NULL — never a
  // silent "Other" — so an untagged holding stays visibly unknown rather
  // than being counted as a real exposure bucket.
  sector         String?
  // Where `sector` came from: "auto" when it was suggested by
  // lib/sectors.ts rather than chosen, so the table can mark a guess as a
  // guess and the owner can tell the two apart. NULL means no tag at all.
  sectorSource   String?
  fetchedAt      DateTime?
  updatedAt      DateTime  @updatedAt

  @@unique([region, ticker])
}

model CashExchange {
  id           Int      @id @default(autoincrement())
  date         DateTime @default(now())
  fromCurrency String
  fromAmount   Float
  toCurrency   String
  toAmount     Float
  rate         Float // toAmount / fromAmount, kept for reference/display
  auto         Boolean // true if the live FX rate was used, false if hand-entered
  createdAt    DateTime @default(now())

  @@index([date])
}

// A sign-in account.
//
// Exists to answer "who is this", not "what may they see" — every account
// sees the same dashboard. The alternative was a single shared password,
// which can answer "is this person allowed in" and nothing else, so anything
// that needs to remember something PER PERSON had nowhere to keep it. The
// first consumer is the dashboard's "since you last looked" line; preferences
// are the next obvious one.
//
// `username` is stored already normalised (lowercased, trimmed — see
// normalizeUsername in lib/auth.ts) so that one person cannot end up with two
// accounts by capitalising their own name differently.
//
// `passwordHash` is a scrypt hash with its own salt and cost parameters
// embedded (lib/password.ts). Nothing anywhere stores or logs a plaintext
// password, and the create-user script types it without echoing it.
//
// `lastSeenAt` is written lazily by whichever page asks for it, throttled, and
// is deliberately nullable: NULL means "never seen", which the dashboard reads
// as "unknown baseline" rather than "just now".
model User {
  id           Int       @id @default(autoincrement())
  username     String    @unique
  passwordHash String
  createdAt    DateTime  @default(now())
  lastSeenAt   DateTime?
}
